    "min_score": 45,
    "category_keywords": ["充电", "音频", "配件", "扫地机器人", "清洁", "安防", "运动相机", "无人机", "运动耳机", "潮玩", "百货", "彩妆", "个护", "美妆", "服饰", "快时尚", "游戏", "储能", "电源", "耳机", "音箱", "智能", "硬件", "消费电子", "fashion", "beauty", "cosmetics", "makeup", "skincare", "audio", "charger", "charging", "earphone", "earbuds", "headphone", "speaker", "smart home", "robot vacuum", "vacuum", "camera", "action camera", "drone", "toy", "toys", "accessories", "consumer electronics", "tech", "gadget", "outdoor", "home appliance"],
